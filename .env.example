# Copier ce fichier vers .env (ignoré par git) et adapter les valeurs.
# Utilisé par docker compose (ports du compose + variables transmises à l'application) et par
# .vscode/launch.json ("daikin2mqtt (avec .env)").
# Toute clé de config.yml peut être surchargée ainsi : Section__Cle=valeur. ATTENTION : une variable l'emporte sur
# config.yml, et donc sur ce que l'interface web enregistre : ne renseignez ici que ce que vous voulez figer.

# --- docker compose ---
# Port publié de l'interface web
PUBLIC_PORT=8080
# Port publié de Mosquitto
#MQTT_PORT=1883

# --- Broker MQTT (défaut : localhost ; "mosquitto" dans config.example.yml pour le docker-compose) ---
#Mqtt__Host=localhost
#Mqtt__Port=1883
#Mqtt__Username=
#Mqtt__Password=

# --- Unités Daikin (module Wi-Fi BRP069C4x, firmware < 2.8.0) ---
#Daikin__Units__0__Id=salon
#Daikin__Units__0__Host=192.168.1.60
#Daikin__Units__0__Name=Clim salon
#Daikin__Units__0__Area=Salon
# Unités simulées, sans matériel
#Daikin__Fake=true

# --- Home Assistant ---
#Device__NodeId=daikin
